# ===============================================================
# AureliaX Unified Backend Environment Configuration
# ===============================================================

# 1. Twilio SMS Gateway (Delivers Real SMS OTPs to physical phones)
# Sign up at https://www.twilio.com (Free trial gives free SMS credits)
# Find your Account SID and Auth Token on the Twilio Console Dashboard:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 2. Optional SMTP Email Gateway (Delivers Real Email OTPs)
# Example for Gmail (use an App Password generated at https://myaccount.google.com/apppasswords):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
